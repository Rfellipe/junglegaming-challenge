# Valores locais. O Compose já usa estes padrões.
# Para rodar fora do Docker: set -a; . ./.env; set +a
HTTP_ADDR=:8080
DATABASE_URL=postgres://wagering:wagering-local@localhost:5432/wagering?sslmode=disable
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_EC2_METADATA_DISABLED=true
SQS_ENDPOINT=http://localhost:4566
SQS_INPUT_QUEUE=wager-transactions.fifo
SQS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo
OIDC_ISSUER_URL=http://localhost:8081/realms/jungle
# Fora do Docker, deixe vazio. No Compose: http://keycloak:8080.
OIDC_BACKCHANNEL_URL=
OIDC_AUDIENCE=wagering-api
DEPENDENCY_TIMEOUT=3s
STARTUP_TIMEOUT=30s
SHUTDOWN_TIMEOUT=15s
